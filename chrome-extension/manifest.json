{
  "manifest_version": 3,
  "name": "Rivue - Fake Review & Trust Detector",
  "version": "1.0.0",
  "description": "Identify fake, duplicate, and paid product reviews across marketplaces. Get genuine trust ratings and explanations.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rivue Review Inspector",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.amazon.in/*",
        "*://*.amazon.co.uk/*",
        "*://*.flipkart.com/*",
        "*://*.walmart.com/*",
        "*://*.bestbuy.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:3001/*",
    "https://api.anakin.io/*",
    "*://*.amazon.com/*",
    "*://*.amazon.in/*",
    "*://*.flipkart.com/*",
    "*://*.walmart.com/*",
    "*://*.bestbuy.com/*"
  ]
}
